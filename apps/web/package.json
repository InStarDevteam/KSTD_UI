{
  "name": "flowcore-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8000 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --check src ../../packages/ui *.json *.ts *.js index.html",
    "format:write": "prettier --write src ../../packages/ui *.json *.ts *.js index.html",
    "preview": "vite preview --host 127.0.0.1 --port 8000 --strictPort",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "verify": "npm run format && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.59.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.10.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4",
    "typescript": "6.0.3",
    "eslint": "10.13.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.0",
    "prettier": "3.9.10"
  }
}
